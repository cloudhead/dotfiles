font=monospace 11
background-color=#080808f2
text-color=#ddddddff
width=360
height=120
outer-margin=12,12,0,0
margin=6
padding=12,14
border-size=1
border-color=#303030ff
border-radius=4
progress-color=over #66ffccff
icons=1
max-icon-size=32
icon-border-radius=3
markup=1
format=<b>%s</b>\n<span foreground="#999999">%b</span>
text-alignment=left
default-timeout=3500
ignore-timeout=1
max-visible=4
anchor=top-right
layer=top

[urgency=low]
border-color=#202020ff
text-color=#999999ff

[urgency=critical]
background-color=#12060aff
border-color=#b03060ff
text-color=#ffffffff
default-timeout=0
